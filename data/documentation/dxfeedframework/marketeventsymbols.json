{"metadata":{"navigatorTitle":[{"text":"MarketEventSymbols","kind":"identifier"}],"roleHeading":"Class","externalID":"s:15DXFeedFramework18MarketEventSymbolsC","modules":[{"name":"DXFeedFramework"}],"symbolKind":"class","title":"MarketEventSymbols","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarketEventSymbols","kind":"identifier"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/dxfeedframework\/marketeventsymbols"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarketEventSymbols","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Regional symbols","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Regional symbol subscription receives events only from a designated exchange, marketplace, or venue","type":"text"},{"text":" ","type":"text"},{"text":"instead of receiving composite events from all venues (by default). Regional symbol is composed from a","type":"text"},{"text":" ","type":"text"},{"text":"base symbol, ampersand character (’&’), and an exchange code character. For example,","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"“SPY” is the symbol for composite events for SPDR S&P 500 ETF from all exchanges,","type":"text"},{"text":" ","type":"text"},{"text":"“SPY&N” is the symbol for event for SPDR S&P 500 ETF that originate only from NYSE marketplace.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Symbol attributes","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Market event symbols can have a number of attributes attached to then in curly braces","type":"text"},{"text":" ","type":"text"},{"text":"with “<key>=<value>” paris separated by commas. For example,","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"“SPY{price=bid}” is the market symbol “SPY” with an attribute key “price” set to value “bid”.","type":"text"},{"text":" ","type":"text"},{"text":"“SPY(=5m,tho=true}” is the market symbol “SPY” with two attributes. One has an empty key and","type":"text"},{"text":" ","type":"text"},{"text":"value “5m”, while the other has key “tho” and value “true”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The methods in this class always maintain attribute keys in alphabetic order.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/docs.dxfeed.com\/dxfeed\/api\/com\/dxfeed\/event\/market\/MarketEventSymbols.html","isActive":true,"type":"reference"}]}]}],"abstract":[{"text":"Helper class to compose and parse symbols for market events.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/MarketEventSymbols"},"hierarchy":{"paths":[["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework"]]},"topicSections":[{"generated":true,"title":"Type Methods","identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/MarketEventSymbols\/changeAttributeStringByKey(_:_:_:)","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/MarketEventSymbols\/changeExchangeCode(_:_:)","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/MarketEventSymbols\/getAttributeStringByKey(_:_:)","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/MarketEventSymbols\/getBaseSymbol(_:)","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/MarketEventSymbols\/getExchangeCode(_:)","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/MarketEventSymbols\/hasExchangeCode(_:)","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/MarketEventSymbols\/removeAttributeStringByKey(_:_:)"],"anchor":"Type-Method