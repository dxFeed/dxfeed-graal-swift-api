{"metadata":{"externalID":"s:15DXFeedFramework11ScheduleDayC","navigatorTitle":[{"kind":"identifier","text":"ScheduleDay"}],"title":"ScheduleDay","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScheduleDay"}],"modules":[{"name":"DXFeedFramework"}],"roleHeading":"Class","symbolKind":"class"},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay"},"hierarchy":{"paths":[["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework"]]},"relationshipsSections":[{"identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/s8CopyableP","doc:\/\/com.dxfeed.DXFeedFramework\/SQ","doc:\/\/com.dxfeed.DXFeedFramework\/s9EscapableP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"abstract":[{"type":"text","text":"Day represents a continuous period of time approximately 24 hours long."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScheduleDay"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"The day is aligned to the start and the end of business activities of a certain business entity or business process."},{"type":"text","text":" "},{"type":"text","text":"For example, the day may be aligned to a trading schedule of a particular instrument on an exchange."},{"type":"text","text":" "},{"type":"text","text":"Thus, different days may start and end at various local times depending on the related trading schedules."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The length of the day depends on the trading schedule and other circumstances. For example, it is possible"},{"type":"text","text":" "},{"type":"text","text":"that day for Monday is longer than 24 hours because it includes part of Sunday; consequently, the day for"},{"type":"text","text":" "},{"type":"text","text":"Sunday will be shorter than 24 hours to avoid overlapping with Monday."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Days do not overlap with each other - rather they form consecutive chain of adjacent periods of time that"},{"type":"text","text":" "},{"type":"text","text":"cover entire time scale. The point on a border line is considered to belong to following day that starts there."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each day consists of sessions that cover entire duration of the day. If day contains at least one trading"},{"type":"text","text":" "},{"type":"text","text":"session (i.e. session within which trading activity is allowed), then the day is considered trading day."},{"type":"text","text":" "},{"type":"text","text":"Otherwise the day is considered non-trading day (e.g. weekend or holiday)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Day may contain sessions with zero duration - e.g. indices that post value once a day."},{"type":"text","text":" "},{"type":"text","text":"Such sessions can be of any appropriate type, trading or non-trading."},{"type":"text","text":" "},{"type":"text","text":"Day may have zero duration as well - e.g. when all time within it is transferred to other days."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/dxfeedframework\/scheduleday"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayId","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayOfMonth","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/da