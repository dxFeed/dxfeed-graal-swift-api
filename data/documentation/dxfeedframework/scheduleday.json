{"hierarchy":{"paths":[["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework"]]},"identifier":{"url":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"s:15DXFeedFramework11ScheduleDayC","modules":[{"name":"DXFeedFramework"}],"title":"ScheduleDay","symbolKind":"class","roleHeading":"Class","navigatorTitle":[{"kind":"identifier","text":"ScheduleDay"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"ScheduleDay","kind":"identifier"}]},"sections":[],"kind":"symbol","relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/SQ"],"title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleDay","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"The day is aligned to the start and the end of business activities of a certain business entity or business process."},{"type":"text","text":" "},{"text":"For example, the day may be aligned to a trading schedule of a particular instrument on an exchange.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Thus, different days may start and end at various local times depending on the related trading schedules."}],"type":"paragraph"},{"inlineContent":[{"text":"The length of the day depends on the trading schedule and other circumstances. For example, it is possible","type":"text"},{"type":"text","text":" "},{"text":"that day for Monday is longer than 24 hours because it includes part of Sunday; consequently, the day for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Sunday will be shorter than 24 hours to avoid overlapping with Monday."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Days do not overlap with each other - rather they form consecutive chain of adjacent periods of time that"},{"text":" ","type":"text"},{"type":"text","text":"cover entire time scale. The point on a border line is considered to belong to following day that starts there."}]},{"type":"paragraph","inlineContent":[{"text":"Each day consists of sessions that cover entire duration of the day. If day contains at least one trading","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"session (i.e. session within which trading activity is allowed), then the day is considered trading day."},{"type":"text","text":" "},{"text":"Otherwise the day is considered non-trading day (e.g. weekend or holiday).","type":"text"}]},{"inlineContent":[{"type":"text","text":"Day may contain sessions with zero duration - e.g. indices that post value once a day."},{"text":" ","type":"text"},{"text":"Such sessions can be of any appropriate type, trading or non-trading.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Day may have zero duration as well - e.g. when all time within it is transferred to other days."}],"type":"paragraph"}]}],"topicSections":[{"title":"Instance Properties","identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayId","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayOfMonth","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayOfWeek","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/endTime","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/holiday","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/monthOfYear","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/resetTime","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/sessions","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/shortDay","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/startTime","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/trading","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/year","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/yearMonthDay"]},{"title":"Instance Methods","identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/getNext(filter:)","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/getPrevious(filter:)"]},{"generated":true,"identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/Equatable-Implementations"],"title":"Default Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/dxfeedframework\/scheduleday"]}],"abstract":[{"type":"text","text":"Day represents a continuous period of time approximately 24 hours long."}],"references":{"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework/ScheduleDay/getNext(filter:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"getNext","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"filter"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:15DXFeedFramework9DayFilterO","text":"DayFilter"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"text":"ScheduleDay","kind":"typeIdentifier","preciseIdentifier":"s:15DXFeedFramework11ScheduleDayC"},{"text":"?","kind":"text"}],"abstract":[],"kind":"symbol","title":"getNext(filter:)","type":"topic","identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramew