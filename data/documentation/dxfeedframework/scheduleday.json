{"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Day represents a continuous period of time approximately 24 hours long."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework"]]},"topicSections":[{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayId","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayOfMonth","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayOfWeek","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/endTime","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/holiday","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/monthOfYear","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/resetTime","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/sessions","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/shortDay","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/startTime","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/trading","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/year","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/yearMonthDay"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/getNext(filter:)","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/getPrevious(filter:)"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/Equatable-Implementations"],"generated":true}],"metadata":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScheduleDay"}],"modules":[{"name":"DXFeedFramework"}],"navigatorTitle":[{"text":"ScheduleDay","kind":"identifier"}],"roleHeading":"Class","externalID":"s:15DXFeedFramework11ScheduleDayC","role":"symbol","symbolKind":"class","title":"ScheduleDay"},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/s8CopyableP","doc:\/\/com.dxfeed.DXFeedFramework\/SQ","doc:\/\/com.dxfeed.DXFeedFramework\/s9EscapableP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleDay","kind":"identifier"}],"platforms":["macOS"]}]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The day is aligned to the start and the end of business activities of a certain business entity or business process.","type":"text"},{"text":" ","type":"text"},{"text":"For example, the day may be aligned to a trading schedule of a particular instrument on an exchange.","type":"text"},{"text":" ","type":"text"},{"text":"Thus, different days may start and end at various local times depending on the related trading schedules.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the day depends on the trading schedule and other circumstances. For example, it is possible"},{"type":"text","text":" "},{"type":"text","text":"that day for Monday is longer than 24 hours because it includes part of Sunday; consequently, the day for"},{"type":"text","text":" "},{"type":"text","text":"Sunday will be shorter than 24 hours to avoid overlapping with Monday."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Days do not overlap with each other - rather they form consecutive chain of adjacent periods of time that"},{"type":"text","text":" "},{"type":"text","text":"cover entire time scale. The point on a border line is considered to belong to following day that starts there."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each day consists of sessions that cover entire duration of the day. If day contains at least one trading"},{"type":"text","text":" "},{"type":"text","text":"session (i.e. session within which trading activity is allowed), then the day is considered trading day."},{"type":"text","text":" "},{"type":"text","text":"Otherwise the day is considered non-trading day (e.g. weekend or holiday)."}]},{"type":"paragraph","inlineContent":[{"text":"Day may contain sessions with zero duration - e.g. indices that post value once a day.","type":"text"},{"text":" ","type":"text"},{"text":"Such sessions can be of any appropriate type, trading or non-trading.","type":"text"},{"text":" ","type":"text"},{"text":"Day may have zero duration as well - e.g. when all time within it is transferred to other days.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/dxfeedframework\/scheduleday"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework/ScheduleDay/resetTime":{"identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/resetTime","type":"topic","abstract":[{"text":"Returns true if trading activity is allowed within this day.","type":"text"},{"text":" ","type":"text"},{"text":"Positive result assumes that day has at least one trading session.","type":"text"}],"title":"resetTime","kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"t