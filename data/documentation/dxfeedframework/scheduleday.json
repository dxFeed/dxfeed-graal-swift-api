{"relationshipsSections":[{"identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/s8CopyableP","doc:\/\/com.dxfeed.DXFeedFramework\/SQ","doc:\/\/com.dxfeed.DXFeedFramework\/s9EscapableP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay"},"metadata":{"modules":[{"name":"DXFeedFramework"}],"roleHeading":"Class","externalID":"s:15DXFeedFramework11ScheduleDayC","navigatorTitle":[{"kind":"identifier","text":"ScheduleDay"}],"role":"symbol","title":"ScheduleDay","symbolKind":"class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleDay","kind":"identifier"}]},"kind":"symbol","abstract":[{"type":"text","text":"Day represents a continuous period of time approximately 24 hours long."}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayId","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayOfMonth","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayOfWeek","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/endTime","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/holiday","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/monthOfYear","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/resetTime","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/sessions","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/shortDay","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/startTime","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/trading","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/year","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/yearMonthDay"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/getNext(filter:)","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/getPrevious(filter:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/Equatable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleDay","kind":"identifier"}],"languages":["swift"]}]},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The day is aligned to the start and the end of business activities of a certain business entity or business process.","type":"text"},{"text":" ","type":"text"},{"text":"For example, the day may be aligned to a trading schedule of a particular instrument on an exchange.","type":"text"},{"text":" ","type":"text"},{"text":"Thus, different days may start and end at various local times depending on the related trading schedules.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The length of the day depends on the trading schedule and other circumstances. For example, it is possible","type":"text"},{"text":" ","type":"text"},{"text":"that day for Monday is longer than 24 hours because it includes part of Sunday; consequently, the day for","type":"text"},{"text":" ","type":"text"},{"text":"Sunday will be shorter than 24 hours to avoid overlapping with Monday.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Days do not overlap with each other - rather they form consecutive chain of adjacent periods of time that","type":"text"},{"text":" ","type":"text"},{"text":"cover entire time scale. The point on a border line is considered to belong to following day that starts there.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each day consists of sessions that cover entire duration of the day. If day contains at least one trading","type":"text"},{"text":" ","type":"text"},{"text":"session (i.e. session within which trading activity is allowed), then the day is considered trading day.","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise the day is considered non-trading day (e.g. weekend or holiday).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Day may contain sessions with zero duration - e.g. indices that post value once a day.","type":"text"},{"text":" ","type":"text"},{"text":"Such sessions can be of any appropriate type, trading or non-trading.","type":"text"},{"text":" ","type":"text"},{"text":"Day may have zero duration as well - e.g. when all time within it is transferred to other days.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/dxfeedframework\/scheduleday"]}],"references":{"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework/ScheduleDay/dayOfWeek":{"identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayOfWeek","type":"topic","abstract":[{"type":"text","text":"Returns ordinal day number in the week starting with 1=Monday and ending with 7=Sunday."}],"kind":"symbol","title":"dayOfWeek","role":"symbol","url":"\/documentation\/dxfeedframework\/scheduleday\/dayofweek","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dayOfWeek","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int32","preciseIdentifier":"s:s5Int32V","kind":"typeIdentifier"}]},"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework/ScheduleDay/sessions":{"identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/sessions","type":"topic","abstract":[{"type":"text","text":"Returns list of sessions that constitute this day."},{"type":"text","text":" "},{"type":"text","text":"The list is ordered according to natural order of sessions - how they occur one after another."}],"kind":"symbol","title":"sessions","role":"symbol","url":"\/documentation\/dxfeedframework\/scheduleday\/sessions","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sessions","kind":"identifier"},{"text":": [","kind":"text"},{"text":"ScheduleSession","preciseIdentifier":"s:15DXFeedFramework15ScheduleSessionC","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework/ScheduleDay/dayOfMonth":{"abstract":[{"text":"Returns ordinal day number in the month starting with 1 for the first day of month.","type":"text"}],"url":"\/documentation\/dxfeedframework\/scheduleday\/dayofmonth","identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/ScheduleDay\/dayOfMonth","role":"symbol","title":"dayOfMonth","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dayOfMonth","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int32","kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V"}],"kind":"symbol"},"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework":{"identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework","type":"topic","abstract":[],"kind":"symbol","title":"DXFeedFramework","role":"collection","url":"\/documentation\/dxfeedframework"},"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework/ScheduleDay/shortDay":