{"hierarchy":{"paths":[["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/WildcardSymbol"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"all","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15DXFeedFramework14WildcardSymbolC","kind":"typeIdentifier","text":"WildcardSymbol","identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/WildcardSymbol"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note","type":"text"}]}],"type":"paragraph"},{"inlineContent":[{"text":"Wildcard subscription can create extremely high network and CPU load for certain kinds of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"high-frequency events like quotes. It requires a special arrangement on the side of upstream data provider and"},{"type":"text","text":" "},{"type":"text","text":"is disabled by default in upstream feed configuration."},{"type":"text","text":" "},{"text":"Make that sure you have adequate resources and understand the impact before using it.","type":"text"},{"type":"text","text":" "},{"text":"It can be used for low-frequency events only (like Forex quotes), because each instance","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"of "},{"identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/DXFeedSubscription","type":"reference","isActive":true},{"text":" processes events in a single thread","type":"text"},{"text":" ","type":"text"},{"text":"and there is no provision to load-balance wildcard","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"subscrip