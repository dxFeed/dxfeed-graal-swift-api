{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"text":"Represents [wildcard] subscription to all events of the specific event type.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"all","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15DXFeedFramework14WildcardSymbolC","text":"WildcardSymbol","identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/WildcardSymbol","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note"}]}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Wildcard subscription can create extremely high network and CPU load for certain kinds of"},{"type":"text","text":" "},{"type":"text","text":"high-frequency events like quotes. It requires a special arrangement on the side of upstream data provider and"},{"type":"text","text":" "},{"type":"text","text":"is disabled by default in upstream feed configuration."},{"type":"text","text":" "},{"type":"text","text":"Make that sure you have adequate resources and understand the impact before using it."},{"type":"text","text":" "},{"type":"text","text":"It can be used for low-frequency events only (like Forex quotes), because each instance"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/DXFeedSubscription"},{"type":"text","text":" processes events in a single thread"},{"type":"text","text":" "},{"type":"text","text":"and there is no provision to load-balance wildcard"},{"type":"text","text":" "},{"type":"text","text":"subscription amongst multiple threads."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/dxfeedframework\/wildcardsymbol\/all"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/WildcardSymbol"]]},"identifier":{"url":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/WildcardSymbol\/all","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"DXFeedFramework"}],"symbolKind":"property","title":"all","externalID":"s:15DXFeedFramework14WildcardSymbolC3allACvpZ","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"all","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15DXFeedFramework14WildcardSymbolC","text":"WildcardSymbol","kind":"typeIdentifier"}],"roleHeading":"Type Property","role":"symbol"},"references":{"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework":{"abstract":[],"url":"\/documentation\/dxfeedframework","title":"DXFeedFramework","kind":"symbol","identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework","type":"topic","role":"collection"},"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework/DXFeedSubscription":{"url":"\/documentation\/dxfeedframework\/dxfeedsubscription","navigatorTitle":[{"text":"DXFeedSubscription","kind":"identifier"}],"title":"DXFeedSubscription","identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/DXFeedSubscription","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DXFeedSubscription","kind":"identifier"}],"abstract":[{"type":"text","text":"Subscription for a set of symbols and event types."}],"type":"topic","kind":"symbol"},"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework/WildcardSymbol/all