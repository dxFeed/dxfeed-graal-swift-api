{"hierarchy":{"paths":[["doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework","doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/WildcardSymbol"]]},"abstract":[{"type":"text","text":"Represents [wildcard] subscription to all events of the specific event type."}],"metadata":{"title":"all","role":"symbol","externalID":"s:15DXFeedFramework14WildcardSymbolC3allACvpZ","modules":[{"name":"DXFeedFramework"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"all","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15DXFeedFramework14WildcardSymbolC","text":"WildcardSymbol","kind":"typeIdentifier"}],"symbolKind":"property","roleHeading":"Type Property"},"identifier":{"url":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/WildcardSymbol\/all","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/dxfeedframework\/wildcardsymbol\/all"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"all"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15DXFeedFramework14WildcardSymbolC","text":"WildcardSymbol","identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/WildcardSymbol","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note"}]}]},{"type":"paragraph","inlineContent":[{"text":"Wildcard subscription can create extremely high network and CPU load for certain kinds of","type":"text"},{"text":" ","type":"text"},{"text":"high-frequency events like quotes. It requires a special arrangement on the side of upstream data provider and","type":"text"},{"text":" ","type":"text"},{"text":"is disabled by default in upstream feed configuration.","type":"text"},{"text":" ","type":"text"},{"text":"Make that sure you have adequate resources and understand the impact before using it.","type":"text"},{"text":" ","type":"text"},{"text":"It can be used for low-frequency events only (like Forex quotes), because each instance","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/DXFeedSubscription"},{"text":" processes events in a single thread","type":"text"},{"text":" ","type":"text"},{"text":"and there is no provision to load-balance wildcard","type":"text"},{"text":" ","type":"text"},{"text":"subscription amongst multiple threads.","type":"text"}]}],"kind":"content"}],"kind":"symbol","references":{"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework/WildcardSymbol/all":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"all","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15DXFeedFramework14WildcardSymbolC","text":"WildcardSymbol","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFramework\/WildcardSymbol\/all","role":"symbol","abstract":[{"text":"Represents [wildcard] subscription to all events of the specific event type.","type":"text"}],"title":"all","url":"\/documentation\/dxfeedframework\/wildcardsymbol\/all"},"doc://com.dxfeed.DXFeedFramework/documentation/DXFeedFramework/WildcardSymbol":{"url":"\/documentation\/dxfeedframework\/wildcardsymbol","title":"WildcardSymbol","identifier":"doc:\/\/com.dxfeed.DXFeedFramework\/documentation\/DXFeedFra